# Database
DATABASE_URL="postgresql://user:password@host.region.neon.tech/database?sslmode=require"

# NextAuth v5 (generate with: openssl rand -base64 32)
AUTH_SECRET="your-secret-here"
# Development:
NEXTAUTH_URL="http://localhost:3000"
# Production (set in Vercel dashboard):
# NEXTAUTH_URL="https://projxodus.com"

# App
# Development:
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Production (set in Vercel dashboard):
# NEXT_PUBLIC_API_URL="https://projxodus.com"

# OAuth Providers (optional - app will work with just email/password if not set)
# Google OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth: https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Pusher (for real-time messaging)
# Get free credentials at: https://pusher.com
PUSHER_APP_ID="your-app-id"
PUSHER_SECRET="your-secret"
NEXT_PUBLIC_PUSHER_KEY="your-key"
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"

# PartyKit (for real-time collaborative document editing)
# Deploy with: npm run party:deploy
# Development: runs on 127.0.0.1:1999 (npm run party:dev)
# Production: exodus-collab.YOUR_USERNAME.partykit.dev
# NEXT_PUBLIC_PARTYKIT_HOST="exodus-collab.your-username.partykit.dev"

# Shared secret for signing PartyKit collaboration tokens. Set the SAME value in
# Vercel and on PartyKit (npx partykit env add PARTYKIT_SECRET), then redeploy
# the party (npm run party:deploy). Generate with: openssl rand -base64 32
# PARTYKIT_SECRET="generate-a-long-random-string"

# Sage AI assistant (Claude). Without a key Sage falls back to keyword replies.
# Get a key at https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override (default: claude-opus-5-5)
# SAGE_MODEL="claude-opus-5-5"

# Rate limiting (optional, recommended in production)
# Upstash Redis REST credentials. Without them, rate limits are kept in memory
# per serverless instance and barely hold. Free tier is enough: https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
